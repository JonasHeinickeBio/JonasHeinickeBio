---
import { getCollection } from 'astro:content';
import Base from '../../layouts/Base.astro';
import PageHeader from '../../components/PageHeader.astro';
import { formatDate, url } from '../../utils';

const posts = (await getCollection('blog', (p) => !p.data.draft)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf(),
);
---
<Base title="Blog" description="Writing on bioinformatics, scientific software and research.">
  <PageHeader eyebrow="Blog" title="Notes & updates" lead="Writing on bioinformatics, scientific software and the PhD journey." />
  <div class="mt-10 max-w-3xl">
  <ul class="mt-10 space-y-4">
    {posts.map((p) => (
      <li>
        <a class="card card-hover block" href={url(`blog/${p.id}/`)}>
          <time class="font-mono text-xs text-slate-500" datetime={p.data.date.toISOString()}>{formatDate(p.data.date)}</time>
          <h2 class="mt-1 text-lg font-semibold text-slate-900 dark:text-white">{p.data.title}</h2>
          <p class="mt-2 text-sm">{p.data.description}</p>
        </a>
      </li>
    ))}
  </ul>
  <p class="mt-8 text-sm"><a class="text-accent-700 hover:underline dark:text-accent-400" href={url('rss.xml')}>RSS feed</a></p>
  </div>
</Base>
