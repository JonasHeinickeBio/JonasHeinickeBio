---
import { getCollection, render } from 'astro:content';
import Base from '../../layouts/Base.astro';
import { formatDate, url } from '../../utils';

export async function getStaticPaths() {
  const posts = await getCollection('blog', (p) => !p.data.draft);
  return posts.map((post) => ({ params: { id: post.id }, props: { post } }));
}
const { post } = Astro.props;
const { Content } = await render(post);
---
<Base title={post.data.title} description={post.data.description}>
  <article class="mx-auto max-w-3xl">
    <a class="text-sm text-accent-700 hover:underline dark:text-accent-400" href={url('blog/')}>← All posts</a>
    <h1 class="mt-4 text-4xl font-bold tracking-tight text-slate-900 dark:text-white">{post.data.title}</h1>
    <p class="mt-3 font-mono text-xs text-slate-500">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    </p>
    <div class="prose-md mt-8"><Content /></div>
  </article>
</Base>
