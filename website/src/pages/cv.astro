---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import { CV, LINKS, SITE, SKILLS } from '../consts';

const blocks = [
  { id: 'education', title: 'Education', items: CV.education },
  { id: 'experience', title: 'Research & projects', items: CV.experience },
];
---
<Base title="CV" description="Curriculum vitae of Jonas Heinicke: education, research projects and skills.">
  <PageHeader eyebrow="Curriculum vitae" title="Jonas Heinicke" lead={`${SITE.role} · ${SITE.affiliation}`}>
    <button type="button" onclick="window.print()" class="btn btn-ghost no-print mt-6">Print / save as PDF</button>
  </PageHeader>

  <div class="mt-12 grid gap-12 lg:grid-cols-[1fr_18rem]">
    <div>
      {blocks.map((b) => (
        <section class="mb-12" aria-labelledby={b.id}>
          <h2 id={b.id} class="section-title">{b.title}</h2>
          <ol class="mt-6 space-y-8 border-l-2 border-slate-200 pl-6 dark:border-slate-800">
            {b.items.map((i) => (
              <li class="relative">
                <span class="absolute -left-[1.95rem] top-1.5 size-3 rounded-full bg-accent-500 ring-4 ring-white dark:ring-slate-950" aria-hidden="true"></span>
                <h3 class="font-semibold text-slate-900 dark:text-white">{i.title}</h3>
                <p class="font-mono text-xs text-slate-500">
                  {[('org' in i ? i.org : ''), i.period].filter(Boolean).join(' · ')}
                </p>
                <div class="prose-md mt-3 text-sm"><ul>{i.points.map((p) => <li>{p}</li>)}</ul></div>
              </li>
            ))}
          </ol>
        </section>
      ))}

      <section aria-labelledby="pubs">
        <h2 id="pubs" class="section-title">Publications & presentations</h2>
        <p class="mt-3">To be updated as publications become available.</p>
      </section>
    </div>

    <aside class="space-y-6 lg:sticky lg:top-24 lg:self-start" aria-label="Skills and links">
      <div class="card">
        <h2 class="eyebrow">Skills</h2>
        <dl class="mt-4 space-y-4 text-sm">
          {SKILLS.map((s) => (
            <div>
              <dt class="font-medium text-slate-900 dark:text-white">{s.group}</dt>
              <dd class="mt-1 leading-relaxed">{s.items.join(' · ')}</dd>
            </div>
          ))}
        </dl>
      </div>
      <div class="card">
        <h2 class="eyebrow">Online</h2>
        <ul class="prose-md mt-3 text-sm"><li><a href={LINKS.github}>GitHub</a></li><li><a href={LINKS.linkedin}>LinkedIn</a></li><li><a href={LINKS.pypi}>PyPI: pyeuropepmc</a></li></ul>
      </div>
    </aside>
  </div>
</Base>
