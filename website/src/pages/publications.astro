---
import Base from '../layouts/Base.astro';
import PageHeader from '../components/PageHeader.astro';
import PublicationList from '../components/PublicationList.astro';
import { LINKS } from '../consts';
---
<Base title="Publications" description="Peer-reviewed articles and preprints by Jonas Heinicke.">
  <PageHeader eyebrow="Publications" title="Papers & preprints" lead="Peer-reviewed articles and preprints, pulled from my ORCID record.">
    <p class="mt-4 text-sm">
      <a class="text-accent-700 underline decoration-accent-500/40 underline-offset-2 hover:decoration-accent-500 dark:text-accent-400" href={LINKS.orcid}>ORCID 0000-0002-8442-3187 ↗</a>
    </p>
  </PageHeader>
  <div class="mt-10 max-w-3xl"><PublicationList /></div>
</Base>
