---
import { LINKS, SITE } from '../consts';
---
<footer class="mt-24 sm:mt-32">
  <div class="container-page">
    <div class="no-print rounded-3xl bg-gradient-to-br from-accent-700 to-sky-700 px-6 py-12 text-center text-white sm:px-12 dark:from-accent-900 dark:to-slate-900 dark:ring-1 dark:ring-slate-800">
      <h2 class="text-2xl font-semibold tracking-tight sm:text-3xl">Let's work on something together</h2>
      <p class="mx-auto mt-3 max-w-xl text-white/80">
        Open to collaborations, research discussions and open-source contributions in computational biology, ME/CFS research and scientific software.
      </p>
      <div class="mt-7 flex flex-wrap justify-center gap-3">
        <a class="btn bg-white text-accent-900 hover:bg-accent-50" href={LINKS.linkedin}>Message me on LinkedIn</a>
        <a class="btn border border-white/40 text-white hover:bg-white/10" href={LINKS.github}>Follow on GitHub</a>
      </div>
    </div>

    <div class="mt-12 flex flex-col items-center justify-between gap-4 border-t border-slate-200 py-8 text-sm text-slate-500 sm:flex-row dark:border-slate-800">
      <p>© {new Date().getFullYear()} {SITE.title} · Built with Astro and Tailwind CSS</p>
      <p class="flex gap-5">
        <a class="hover:text-accent-600" href={LINKS.github} rel="me">GitHub</a>
        <a class="hover:text-accent-600" href={LINKS.linkedin} rel="me">LinkedIn</a>
        <a class="hover:text-accent-600" href={LINKS.orcid} rel="me">ORCID</a>
        <a class="hover:text-accent-600" href={LINKS.pypi}>PyPI</a>
      </p>
    </div>
  </div>
</footer>
