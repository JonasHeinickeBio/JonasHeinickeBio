---
interface Props {
  eyebrow: string;
  title: string;
  lead?: string;
}
const { eyebrow, title, lead } = Astro.props;
---
<header class="border-b border-slate-200 pb-10 dark:border-slate-800">
  <p class="eyebrow">{eyebrow}</p>
  <h1 class="page-title mt-3">{title}</h1>
  {lead && <p class="mt-4 max-w-2xl text-lg leading-relaxed">{lead}</p>}
  <slot />
</header>
