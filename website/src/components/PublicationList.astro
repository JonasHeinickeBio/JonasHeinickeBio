---
import pubs from '../data/publications.json';

interface Pub {
  title: string;
  authors: string;
  journal: string | null;
  year: number;
  doi: string;
  preprint: boolean;
}
const items = pubs as Pub[];
const years = [...new Set(items.map((p) => p.year))];

// Bold my own name in author lists.
const escape = (s: string) => s.replace(/&/g, '&amp;').replace(/</g, '&lt;');
const authors = (s: string) => escape(s).replace(/Heinicke JI?\b/g, '<strong class="text-slate-900 dark:text-white">$&</strong>');
---
{items.length === 0 && <p>No publications to show yet.</p>}
{years.map((y) => (
  <section class="mb-10" aria-label={String(y)}>
    <h2 class="font-mono text-sm text-slate-500">{y}</h2>
    <ul class="mt-3 space-y-5 border-l-2 border-slate-200 pl-5 dark:border-slate-800">
      {items.filter((p) => p.year === y).map((p) => (
        <li>
          <a class="font-medium text-slate-900 hover:text-accent-700 dark:text-white dark:hover:text-accent-400" href={`https://doi.org/${p.doi}`}>{p.title}</a>
          <p class="mt-1 text-sm" set:html={authors(p.authors)} />
          <p class="mt-1 text-sm text-slate-500">
            {p.preprint ? <span class="tag">Preprint</span> : <em>{p.journal}</em>}
            <a class="ml-2 font-mono text-xs hover:underline" href={`https://doi.org/${p.doi}`}>doi:{p.doi}</a>
          </p>
        </li>
      ))}
    </ul>
  </section>
))}
