---
import { url } from '../utils';

const images = [
  { file: 'github-metrics.svg', alt: 'GitHub activity overview: commits, pull requests, issues and repositories', w: 480, h: 367 },
  { file: 'metrics.plugin.isocalendar.fullyear.svg', alt: 'Isometric contribution calendar for the last year', w: 480, h: 330 },
];
---
<div class="grid gap-4 md:grid-cols-2">
  {images.map((i) => (
    // The SVGs are designed for a light background, so they always sit on a white surface.
    <div class="flex items-start justify-center overflow-hidden rounded-2xl border border-slate-200 bg-white p-4 dark:border-slate-700">
      <img src={url(`metrics/${i.file}`)} alt={i.alt} width={i.w} height={i.h} loading="lazy" class="h-auto w-full max-w-[480px]" />
    </div>
  ))}
</div>
<p class="mt-3 text-xs text-slate-500">
  Generated daily with <a class="underline hover:text-accent-600" href="https://github.com/lowlighter/metrics">lowlighter/metrics</a> from my GitHub activity.
</p>
