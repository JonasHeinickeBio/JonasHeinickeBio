---
import type { CollectionEntry } from 'astro:content';
interface Props {
  project: CollectionEntry<'projects'>;
  large?: boolean;
}
const { project, large = false } = Astro.props;
const { data } = project;
const link = 'text-accent-700 hover:underline dark:text-accent-400';
---
<article class:list={['card card-hover flex flex-col', large && 'md:col-span-2 md:p-8']}>
  {large && <p class="eyebrow mb-3">Flagship</p>}
  <h3 class:list={['font-semibold text-slate-900 dark:text-white', large ? 'text-2xl' : 'text-lg']}>{data.title}</h3>
  <p class:list={['mt-2 flex-1 leading-relaxed', large ? 'max-w-2xl text-base' : 'text-sm']}>{data.description}</p>
  <ul class="mt-4 flex flex-wrap gap-2" aria-label="Technologies">
    {data.tags.map((t) => <li class="tag">{t}</li>)}
  </ul>
  <p class="mt-5 flex flex-wrap gap-x-4 gap-y-1 text-sm font-medium">
    <a class={link} href={data.repo}>GitHub ↗</a>
    {data.docs && <a class={link} href={data.docs}>Docs ↗</a>}
    {data.pypi && <a class={link} href={data.pypi}>PyPI ↗</a>}
  </p>
</article>
